# Copy to .env in this directory before `docker compose up`.
# For `npm run dev` in backend/, copy this file to backend/.env and set:
#   DB_HOST=localhost
#   DB_PORT=5433

NODE_ENV=development

# At least 32 characters. Do not deploy the placeholder below.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters

ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

POSTGRES_DB=teamboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_HOST=db
DB_PORT=5432
DB_NAME=teamboard
DB_USER=postgres
DB_PASSWORD=postgres
